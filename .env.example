# ============================================================
#   India News Intelligence Platform — Environment Variables
#   Copy this file to .env and fill in your actual values.
# ============================================================

# ── Discord ──────────────────────────────────────────────────
# Your Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# The channel ID where auto-published news is posted
DISCORD_CHANNEL_ID=your_news_channel_id_here

# The channel ID for system alerts (can be the same or a private channel)
DISCORD_ALERT_CHANNEL_ID=your_alert_channel_id_here

# Your own Discord User ID (for Director DM alerts)
DISCORD_DIRECTOR_USER_ID=your_discord_user_id_here

# ── LLM Provider ─────────────────────────────────────────────
# Options: gemini | openai | groq | ollama
LLM_PROVIDER=gemini

# Google Gemini API Key (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq API Key (if LLM_PROVIDER=groq — very fast, free tier available)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Ollama base URL (if LLM_PROVIDER=ollama — fully local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── News APIs (Optional — enhances coverage) ─────────────────
# NewsAPI.org key (free tier: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# ── Schedule ─────────────────────────────────────────────────
# How often (in hours) to auto-publish news to Discord
PUBLISH_INTERVAL_HOURS=2

# Maximum stories to collect per run (before dedup/ranking)
MAX_ARTICLES_PER_RUN=200

# Top stories to publish per run
TOP_STORIES_TO_PUBLISH=10

# ── Storage ──────────────────────────────────────────────────
DATABASE_PATH=storage/news.db
LOG_DIR=storage/logs
LOG_LEVEL=INFO

# ── Platform Behavior ────────────────────────────────────────
# Set to true to run the full pipeline WITHOUT posting to Discord
DRY_RUN=false

# Enable browser automation (requires: playwright install chromium)
ENABLE_BROWSER_AUTOMATION=false

# Request timeout in seconds for HTTP requests
REQUEST_TIMEOUT_SECONDS=15

# How many parallel RSS workers to run
RSS_WORKER_CONCURRENCY=8

# Semantic similarity threshold for deduplication (0.0-1.0)
DEDUP_SIMILARITY_THRESHOLD=0.82

# Minimum confidence score to publish a story (0.0-1.0)
MIN_CONFIDENCE_SCORE=0.5

# ── Health Monitor ────────────────────────────────────────────
# Interval in seconds for agent heartbeat checks
HEARTBEAT_CHECK_INTERVAL=60

# Seconds before an agent is considered stale/crashed
AGENT_STALE_THRESHOLD_SECONDS=180

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_PORT=8080
ENABLE_DASHBOARD=true
